{
  "name": "Kouchan Game",
  "dockerComposeFile": "../compose.yaml",
  "service": "app",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",

  // Alpine の sh(busybox ash)は、対話シェル起動時に $ENV が指すファイルを読み込む。
  // そこで aliases.sh を source させることで、ターミナルで alias が使えるようになる。
  "containerEnv": {
    "ENV": "/root/.ashrc"
  },
  "postCreateCommand": "echo '[ -f /app/.devcontainer/aliases.sh ] && . /app/.devcontainer/aliases.sh' > /root/.ashrc",

  "customizations": {
    "vscode": {
      "extensions": [
        // 言語パック / AI
        "ms-ceintl.vscode-language-pack-ja",
        "anthropic.claude-code",

        // フロントエンド (Vue / Nuxt / JS)
        "vue.volar",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "xabikos.javascriptsnippets",
        "dsznajder.es7-react-js-snippets",
        "styled-components.vscode-styled-components",
        "formulahendry.auto-rename-tag",
        "htmlhint.vscode-htmlhint",
        "ritwickdey.liveserver",

        // PHP / Laravel
        "bmewburn.vscode-intelephense-client",
        "junstyle.php-cs-fixer",
        "onecentlin.laravel-extension-pack",
        "onecentlin.laravel-blade",
        "onecentlin.laravel5-snippets",
        "shufo.vscode-blade-formatter",
        "ihunte.laravel-blade-wrapper",
        "amiralizadeh9480.laravel-extra-intellisense",
        "codingyu.laravel-goto-view",
        "naoray.laravel-goto-components",
        "pgl.laravel-jump-controller",
        "glitchbl.laravel-create-view",
        "ryannaddy.laravel-artisan",

        // Git
        "eamodio.gitlens",
        "seatonjiang.gitmoji-vscode",

        // Docker / DB
        "docker.docker",
        "ms-azuretools.vscode-docker",
        "ms-azuretools.vscode-containers",
        "damms005.devdb",

        // エディタ支援
        "editorconfig.editorconfig",
        "mikestead.dotenv",
        "christian-kohler.path-intellisense",
        "ionutvmi.path-autocomplete",
        "streetsidesoftware.code-spell-checker",
        "shardulm94.trailing-spaces",
        "mosapride.zenkaku",
        "oderwat.indent-rainbow",
        "leodevbro.blockman",
        "alefragnani.bookmarks",
        "pdconsec.vscode-print",

        // ドキュメント / 図
        "jebbs.plantuml",
        "hediet.vscode-drawio",

        // 外観
        "akamud.vscode-theme-onedark",
        "vscode-icons-team.vscode-icons",
        "johnpapa.vscode-peacock"
      ]
    }
  }
}
